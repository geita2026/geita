Options -Indexes -MultiViews
RewriteEngine On

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|eot|otf|ttc|ttf|woff2?)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Preserve Authorization headers for Laravel.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Allow existing cPanel certificate validation files.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^\.well-known/(?:acme-challenge|pki-validation)/[A-Za-z0-9_-]+(?:\.txt)?$ - [END]

# Keep dotfiles and internal paths out of the public URL space.
RewriteRule (^|/)\. - [F]
RewriteRule ^public(?:/|$) - [F,NC]

# Block script extensions, including filenames with more than one extension.
RewriteRule \.(?:php[0-9]*|phar|phtml|pht|cgi|fcgi|pl|shtml)(?:[./]|$) - [F,NC]

# Only serve static files from Laravel's public directory.
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.+\.(?:avif|css|csv|eot|gif|html?|ico|jpe?g|js|json|mjs|otf|pdf|png|svg|tsv|ttc|ttf|txt|webmanifest|webp|woff2?))$ public/$1 [END,NC]

# Reject direct requests for files outside the public directory.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [F]

# Send application routes to Laravel.
RewriteRule ^ public/index.php [END]
