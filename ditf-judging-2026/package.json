{
  "name": "ditf-judging-2026",
  "private": true,
  "version": "0.1.0",
  "description": "Judging system for the 50th Dar es Salaam International Trade Fair (DITF) 2026 — exhibitor stand/pavilion awards.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/survey"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web dev:survey",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "dev:survey": "npm run dev --workspace survey",
    "db:generate": "npm run prisma:generate --workspace api",
    "db:migrate": "npm run prisma:migrate --workspace api",
    "db:seed": "npm run seed --workspace api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
