// DITF 2026 Judging — Prisma schema (MySQL / MariaDB, e.g. XAMPP)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  JUDGE
  EXHIBITOR
}

enum CategoryGroup {
  ORDINARY
  SPECIAL_EXHIBITOR
  SPECIAL_PAVILION
  RECOGNITION
  GRAND
}

enum EventPhase {
  REGISTRATION
  SCORING
  R1_DONE
  SECOND_ROUND
  CLOSED
}

enum ExhibitorStatus {
  REGISTERED
  SCORING
  RANKED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(JUDGE)
  judge     Judge?
  createdAt DateTime @default(now())
}

model Event {
  id                   String      @id @default(uuid())
  name                 String
  theme                String      @db.Text
  registrationDeadline DateTime
  phase                EventPhase  @default(REGISTRATION)
  categories           Category[]
  exhibitors           Exhibitor[]
  createdAt            DateTime    @default(now())
}

model Rubric {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  totalPoints Int
  groups      RubricGroup[]
  categories  Category[]
}

model RubricGroup {
  id       String       @id @default(uuid())
  rubricId String
  rubric   Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  code     String
  title    String
  maxMark  Int
  sort     Int          @default(0)
  items    RubricItem[]
}

model RubricItem {
  id          String      @id @default(uuid())
  groupId     String
  group       RubricGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code        String
  description String      @db.Text
  maxMark     Int
  sort        Int         @default(0)
  scores      Score[]
}

model Category {
  id         String        @id @default(uuid())
  eventId    String
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order         Int
  name          String
  group         CategoryGroup
  samsCategoryId String?      @unique // maps to SAMS judging_categories.categoryId (resolved on sync)
  rubricId      String?
  rubric     Rubric?       @relation(fields: [rubricId], references: [id])
  exhibitors Exhibitor[]
  assignments JudgeAssignment[]
  results    Result[]
}

model Exhibitor {
  id            String          @id @default(uuid())
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  externalId    String?         @unique // SAMS companyID; null for manual entries
  source        String          @default("SAMS") // SAMS | MANUAL
  companyName   String
  contactEmail  String?
  contactPhone  String?
  standLocation String?
  isForeign     Boolean         @default(false)
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  status        ExhibitorStatus @default(REGISTERED)
  scores        Score[]
  submissions   JudgeSubmission[]
  results       Result[]
  syncedAt      DateTime?
  createdAt     DateTime        @default(now())
}

model Judge {
  id          String            @id @default(uuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String            @unique
  active      Boolean           @default(true)
  assignments JudgeAssignment[]
  scores      Score[]
  submissions JudgeSubmission[]
}

// A judge's final, locked submission of their scores for one exhibitor in a round.
// Created only when every rubric item has been scored. Its presence both locks the
// sheet (no more edits) and is what makes the judge's scores count in the results.
model JudgeSubmission {
  id          String    @id @default(uuid())
  judgeId     String
  judge       Judge     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  exhibitorId String
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  round       Int       @default(1)
  submittedAt DateTime  @default(now())

  @@unique([judgeId, exhibitorId, round])
}

model JudgeAssignment {
  id         String   @id @default(uuid())
  judgeId    String
  judge      Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([judgeId, categoryId])
}

model Score {
  id           String     @id @default(uuid())
  exhibitorId  String
  exhibitor    Exhibitor  @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  judgeId      String
  judge        Judge      @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  rubricItemId String
  rubricItem   RubricItem @relation(fields: [rubricItemId], references: [id], onDelete: Cascade)
  value        Float      @default(0)
  round        Int        @default(1)
  updatedAt    DateTime   @updatedAt

  @@unique([exhibitorId, judgeId, rubricItemId, round])
}

model Result {
  id          String    @id @default(uuid())
  exhibitorId String
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  round       Int       @default(1)
  average     Float
  rank        Int
  manual      Boolean   @default(false) // admin-overridden podium; Compute won't overwrite it
  createdAt   DateTime  @default(now())

  @@unique([categoryId, exhibitorId, round])
}

// DITF participants' pre-seminar feedback form ("Fomu ya Maoni"). Public submissions;
// one row per respondent. q4 holds a JSON array of selected topics.
model SurveyResponse {
  id          String   @id @default(uuid())
  companyName String
  participant String
  phone       String?
  surveyDate  String?
  q1          String? // satisfaction with the training
  q2          String? // usefulness of the content
  q3          String? // trainer effectiveness
  q4          String   @default("[]") @db.Text // most useful topics (JSON array)
  q5          String?  @db.Text // liked most
  q6          String?  @db.Text // to improve
  q7          String?  @db.Text // extra comments
  createdAt   DateTime @default(now())
}
