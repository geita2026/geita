# Copy to .env and adjust. Defaults match a local XAMPP MySQL (root / no password).
DATABASE_URL="mysql://root:@127.0.0.1:3306/ditf_judging_2026"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated allowed origins for CORS (the Next.js dev server)
CORS_ORIGIN="http://localhost:3000"

# SAMS (tradefair) database — READ ONLY. Used to sync confirmed exhibitors.
# Local: point at the imported dump (e.g. mis_update). Prod: the live SAMS DB.
SAMS_DATABASE_URL="mysql://root:@127.0.0.1:3306/mis_update"
