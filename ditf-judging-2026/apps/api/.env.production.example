# Copy to apps/api/.env ON THE SERVER and fill in real values.
# Judging app's OWN database (create it + a user on the prod MariaDB first).
DATABASE_URL="mysql://ditf_user:CHANGE_ME@127.0.0.1:3306/ditf_judging_2026"

# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET="CHANGE_ME_LONG_RANDOM"

PORT=4000
CORS_ORIGIN="https://tradefair.tantrade.go.tz"

# SAMS (tradefair) database — READ ONLY. Prod SAMS DB + its user.
SAMS_DATABASE_URL="mysql://sams:CHANGE_ME@127.0.0.1:3306/tradefair_live"
