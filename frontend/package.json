{
  "name": "gememis-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "GeMEMIS — Geita Mineral Exhibition Management Information System (web client)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.22.0",
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "distortion-wave": "0.4.0",
    "motion": "^13.4.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@next/eslint-plugin-next": "16.2.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "daisyui": "^5.7.43",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "8.5.23",
    "prettier": "^3.9.8",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.1.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.12"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true,
    "@tailwindcss/oxide": true,
    "esbuild": true
  }
